# ===== TTS 提供方 =====
# 工作台访问密钥（必填；浏览器首次访问时输入，测试阶段至少 8 位）
WORKSTATION_API_KEY=请设置测试密钥
# 单文件上传上限，单位 MB
MAX_UPLOAD_MB=4096
# 仅在 HTTPS 部署时设为 true
COOKIE_SECURE=false

# edge  = 微软 Edge 免费 TTS(默认, 免 key, 免凭证, km-KH-SreymomNeural 神经语音)
# google = Google Cloud Text-to-Speech(需下方凭证, 生产环境更稳可切换)
TTS_PROVIDER=edge
# edge-tts 高棉语声音(已验证可用)
EDGE_VOICE=km-KH-SreymomNeural

# ===== Google Cloud TTS 凭证(仅 TTS_PROVIDER=google 时需要) =====
# 高棉语配音使用 Google Cloud Text-to-Speech 免费层(每月前 100 万字符免费)
# 在 Google Cloud 控制台创建服务账号，下载 JSON 凭证，把路径填到这里
GOOGLE_APPLICATION_CREDENTIALS=/绝对路径/service-account.json

# ===== LLM 翻译配置(OpenAI / DeepSeek 兼容接口) =====
# 已验证可用：阿里云百炼 DashScope 兼容模式 + deepseek-v4-flash
# 通用说明：任何 OpenAI 兼容接口都行，改 BASE_URL / MODEL / KEY 即可
LLM_PROVIDER=dashscope
LLM_API_KEY=sk-你的key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4-flash

# ===== Whisper ASR =====
# 中文短剧实测推荐 large-v3-turbo；模型已放入可迁移的 Hugging Face 缓存目录
WHISPER_MODEL=large-v3-turbo
# 本地模型缓存根目录（run.sh 已默认设置；迁移时连同源码目录一起复制）
HF_HOME=/home/juzer/drama_localizer_ym/models/huggingface
TORCH_HOME=/home/juzer/drama_localizer_ym/models/torch
XDG_CACHE_HOME=/home/juzer/drama_localizer_ym/models/cache

# ===== 语言对 =====
SRC_LANG=zh
TGT_LANG=km
# 工作台默认目标语言(可前端随时切换)：km 高棉语 / th 泰语 / en 英语 / vi 越南语 / lo 老挝语 / my 缅甸语 / ja 日语 / ko 韩语 / fr 法语 / es 西班牙语
TARGET_LANG=km
# 字幕未标 [w]/[m] 时的默认性别 voice：female 或 male
DEFAULT_GENDER=female

# ===== 高棉语 TTS 语音 =====
# km-KH-Standard-A 是标准语音，享受免费层；可在 GCP 控制台试听其他 km-KH 音色
TTS_VOICE=km-KH-Standard-A
TTS_PITCH=0
TTS_SPEED=1.0

# ===== 字幕 =====
# true=烧录进画面；false=封装为可开关软字幕(默认)
BURN_SUBTITLE=false

# ===== 可选：专有名词术语表 =====
# 建一个 txt，每行写 "中文=高棉语"，翻译时会强制统一，保证整部剧一致
GLOSSARY_PATH=
